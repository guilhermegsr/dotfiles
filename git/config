[user]
    # ~/.config/git/config.local

[init]
    defaultBranch = main

[pull]
    rebase = true

[push]
    autoSetupRemote = true
    followTags = true

[fetch]
    prune = true

[core]
    autocrlf = input

[diff]
    colorMoved = default
    algorithm = histogram

[merge]
    conflictStyle = zdiff3

[rebase]
    autoStash = true

[rerere]
    enabled = true
    autoUpdate = true

[alias]
    st = status -sb
    co = checkout
    br = branch
    ci = commit
    cm = commit -m
    ca = commit --amend
    can = commit --amend --no-edit
    df = diff
    dfs = diff --staged
    lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
    lga = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --all
    unstage = reset HEAD --
    last = log -1 HEAD --stat

# Shared settings only. This file is included by ~/.config/git/config, a
# machine-local file that also includes ~/.config/git/config.local (identity,
# credential helpers) and absorbs every `git config --global` write. Keeping
# the global config outside the repository is what stops tools such as
# `gh auth setup-git` from writing machine paths into version control.
